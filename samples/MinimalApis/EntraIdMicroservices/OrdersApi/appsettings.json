{
    "AzureAd": {
        "Instance": "https://login.microsoftonline.com/",
        "TenantId": "<tenant-id>", // Required: the ID of the Microsoft Entra ID tenant
        "ClientId": "<orders-api-client-id>", // Required: the application (client) ID of the Orders API
        // Credentials are needed because this API calls the Inventory API.
        // In Azure, use a managed identity that is federated with the app registration, so that no secret is required.
        // For local development, see the README file.
        "ClientCredentials": [
            {
                "SourceType": "SignedAssertionFromManagedIdentity",
                "ManagedIdentityClientId": "<managed-identity-client-id>"
            }
        ]
    },
    "DownstreamApis": {
        "Inventory": {
            "BaseAddress": "https://localhost:7102/", // Required: it must use HTTPS and end with a trailing slash
            "Scope": "api://<inventory-api-client-id>/.default" // Required: the Application ID URI of the Inventory API, followed by /.default
            //"AuthenticationScheme": "EntraId", // Default: EntraId
            //"AllowHttpOnLoopback": false, // Default: false
            //"Resilience": {
            //    "TotalRequestTimeout": {
            //        "Timeout": "00:00:30" // Default: 30 seconds
            //    },
            //    "AttemptTimeout": {
            //        "Timeout": "00:00:10" // Default: 10 seconds
            //    },
            //    "Retry": {
            //        "MaxRetryAttempts": 3 // Default: 3
            //    }
            //}
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
